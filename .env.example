# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored (via the *.local rule) -- never commit real keys here.
# The Supabase key here is the publishable/anon key, safe to ship in a built JS bundle.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
